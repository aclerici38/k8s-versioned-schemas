{
  "description": "ProxmoxTemplate is the Schema for the ProxmoxTemplate API",
  "properties": {
    "apiVersion": {
      "description": "APIVersion defines the versioned schema of this representation of an object.\nServers should convert recognized schemas to the latest internal value, and\nmay reject unrecognized values.\nMore info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources",
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "description": "Kind is a string value representing the REST resource this object represents.\nServers may infer this from the endpoint the client submits requests to.\nCannot be updated.\nIn CamelCase.\nMore info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds",
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ]
    },
    "spec": {
      "additionalProperties": false,
      "description": "Spec defines the desired state of ProxmoxTemplate",
      "properties": {
        "agent": {
          "additionalProperties": false,
          "description": "QemuGuestAgent enables the QEMU Guest Agent service in the VM template.",
          "properties": {
            "enabled": {
              "default": false,
              "description": "Enable QEMU Guest Agent service in the VM template.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "fsFreezeOnBackup": {
              "description": "FsFreezeOnBackup enables the file system freeze operation during backup.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "fsTrimClonedDisks": {
              "description": "FsTrimClonedDisks enables the discard/TRIM operation on cloned disks.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "type": {
              "default": "virtio",
              "description": "Type of QEMU Guest Agent channel.",
              "enum": [
                "virtio",
                "isa"
              ],
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "bios": {
          "default": "seabios",
          "description": "BIOS type for the VM template.",
          "enum": [
            "seabios",
            "ovmf"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "cpu": {
          "additionalProperties": false,
          "default": {
            "type": "x86-64-v2-AES"
          },
          "description": "CPU configuration",
          "properties": {
            "flags": {
              "description": "List of additional CPU flags",
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "type": [
                "array",
                "null"
              ]
            },
            "type": {
              "default": "x86-64-v2-AES",
              "description": "Emulated CPU type.",
              "enum": [
                "host",
                "kvm64",
                "x86-64-v2",
                "x86-64-v2-AES",
                "x86-64-v3",
                "x86-64-v4"
              ],
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "description": {
          "description": "Description for the VM template.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "machine": {
          "default": "q35",
          "description": "Machine for the VM machine type.",
          "enum": [
            "pc",
            "q35"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "network": {
          "description": "Network defines the network configuration for the VM template",
          "items": {
            "additionalProperties": false,
            "description": "Network defines the network configuration for the VM template",
            "properties": {
              "address4": {
                "description": "Address4 ip address with prefix length",
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "address6": {
                "description": "Address6 ip address with prefix length",
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "bridge": {
                "description": "Bridge to attach the network device to.",
                "minLength": 1,
                "type": "string"
              },
              "dnsServers": {
                "description": "DNS Servers",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": [
                  "array",
                  "null"
                ]
              },
              "firewall": {
                "description": "Whether this interface should be protected by the firewall.",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "gateway4": {
                "description": "Gateway4 Address",
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "gateway6": {
                "description": "Gateway6 Address",
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "default": "virtio",
                "description": "Network Card Model.",
                "enum": [
                  "e1000",
                  "e1000e",
                  "rtl8139",
                  "virtio",
                  "vmxnet3"
                ],
                "type": [
                  "string",
                  "null"
                ]
              },
              "mtu": {
                "default": 1500,
                "description": "Force MTU of network device.",
                "type": [
                  "integer",
                  "null"
                ],
                "x-kubernetes-validations": [
                  {
                    "rule": "self == 1 || ( self \u003e= 576 \u0026\u0026 self \u003c= 65520)"
                  }
                ]
              },
              "name": {
                "description": "Name of the network interface.",
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "vlan": {
                "description": "VLAN tag to apply to packets on this interface.",
                "maximum": 4094,
                "minimum": 1,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "bridge"
            ],
            "type": "object"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        },
        "onBoot": {
          "description": "OnBoot specifies whether the VM should be automatically started when the Proxmox host boots.\nNodes cloned from this template inherit this setting.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "pciDevices": {
          "description": "PCIDevices is a list of PCI devices to attach to the VM template\nSupported Mapping devices only",
          "items": {
            "additionalProperties": false,
            "description": "PCIDevice defines a PCI device to attach to the VM template",
            "properties": {
              "mapping": {
                "description": "Mapping is the PCI address of the device to attach.",
                "minLength": 1,
                "type": "string"
              },
              "mdev": {
                "description": "MDev is the mediated device type to attach.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "pcie": {
                "description": "PCIE indicates if the device is a PCI Express device.",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "xvga": {
                "description": "XVGA indicates that GPU set to primary display.",
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "mapping"
            ],
            "type": "object"
          },
          "maxItems": 6,
          "type": [
            "array",
            "null"
          ]
        },
        "region": {
          "description": "Region is the Proxmox Cloud region where VM template will be created",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "resourcePool": {
          "description": "ResourcePool is the Proxmox resource pool name where template VMs will be placed.\nIf specified, template will be added to this pool during creation.\nThe pool must already exist in Proxmox.",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*){0,2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "sourceImage": {
          "additionalProperties": false,
          "description": "SourceImage defines the source image for the VM boot disk.",
          "properties": {
            "checksum": {
              "description": "Checksum is a hash of the checksum.",
              "maxLength": 128,
              "minLength": 32,
              "type": [
                "string",
                "null"
              ]
            },
            "checksumType": {
              "description": "ChecksumType is the algorithm to calculate the checksum of the file.",
              "enum": [
                "md5",
                "sha1",
                "sha224",
                "sha256",
                "sha384",
                "sha512"
              ],
              "type": [
                "string",
                "null"
              ]
            },
            "imageName": {
              "description": "ImageName is the prefix name of the destination image.",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "description": "URL is the location of the source image.",
              "pattern": "^https?://[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}(/\\S*)?$",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "type": "object"
        },
        "storageIDs": {
          "description": "StorageIDs is a list of storage IDs where the VM template and base image will be stored.\nStorage should supports images and import content types.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "tags": {
          "description": "Tags to apply to the VM template",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "type": [
            "array",
            "null"
          ]
        },
        "tpm": {
          "additionalProperties": false,
          "description": "TPM configuration for the trusted platform module.",
          "properties": {
            "version": {
              "default": "v2.0",
              "description": "Version of TPM device.",
              "enum": [
                "v1.2",
                "v2.0"
              ],
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "vga": {
          "additionalProperties": false,
          "description": "VGA configuration",
          "properties": {
            "memory": {
              "description": "Sets the VGA memory in MiB.",
              "maximum": 512,
              "minimum": 4,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "default": "std",
              "description": "Emulated VGA type.",
              "enum": [
                "none",
                "serial0",
                "std",
                "vmware"
              ],
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "network",
        "sourceImage",
        "storageIDs"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "status": {
      "additionalProperties": false,
      "description": "Status defines the observed state of ProxmoxTemplate",
      "properties": {
        "conditions": {
          "description": "Conditions contains signals for health and readiness",
          "items": {
            "additionalProperties": false,
            "description": "Condition aliases the upstream type and adds additional helper methods",
            "properties": {
              "lastTransitionTime": {
                "description": "lastTransitionTime is the last time the condition transitioned from one status to another.\nThis should be when the underlying condition changed.  If that is not known, then using the time when the API field changed is acceptable.",
                "format": "date-time",
                "type": "string"
              },
              "message": {
                "description": "message is a human readable message indicating details about the transition.\nThis may be an empty string.",
                "maxLength": 32768,
                "type": "string"
              },
              "observedGeneration": {
                "description": "observedGeneration represents the .metadata.generation that the condition was set based upon.\nFor instance, if .metadata.generation is currently 12, but the .status.conditions[x].observedGeneration is 9, the condition is out of date\nwith respect to the current state of the instance.",
                "format": "int64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "reason": {
                "description": "reason contains a programmatic identifier indicating the reason for the condition's last transition.\nProducers of specific condition types may define expected values and meanings for this field,\nand whether the values are considered a guaranteed API.\nThe value should be a CamelCase string.\nThis field may not be empty.",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$",
                "type": "string"
              },
              "status": {
                "description": "status of the condition, one of True, False, Unknown.",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ],
                "type": "string"
              },
              "type": {
                "description": "type of condition in CamelCase or in foo.example.com/CamelCase.",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$",
                "type": "string"
              }
            },
            "required": [
              "lastTransitionTime",
              "message",
              "reason",
              "status",
              "type"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "imageID": {
          "description": "ImageID is the ID of the image.",
          "type": [
            "string",
            "null"
          ]
        },
        "resources": {
          "additionalProperties": {
            "oneOf": [
              {
                "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "x-kubernetes-int-or-string": true
          },
          "description": "Resources is the list of resources that have been provisioned.",
          "type": [
            "object",
            "null"
          ]
        },
        "zones": {
          "description": "Zones is a list of nodes that VM template was prepared.\nThis field is populated by the controller and should not be set manually.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    }
  },
  "type": "object"
}