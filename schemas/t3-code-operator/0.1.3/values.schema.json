{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image", "leaderElection", "miseCacheSizeLimit", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 8 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
        "leaderElection": { "type": "boolean" },
        "miseCacheSizeLimit": { "type": "string", "minLength": 1 },
        "resources": { "type": "object" },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "extraEnv": { "type": "array", "items": { "type": "object" } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": { "type": "boolean" },
        "secretResourceNames": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        }
      }
    },
    "workstations": { "type": "array", "items": { "$ref": "#/definitions/projectResource" } },
    "harnesses": { "type": "array", "items": { "$ref": "#/definitions/projectResource" } },
    "extensions": { "type": "array", "items": { "$ref": "#/definitions/projectResource" } },
    "mcpServers": { "type": "array", "items": { "$ref": "#/definitions/projectResource" } },
    "extraObjects": { "type": "array", "items": { "type": "object" } }
  },
  "definitions": {
    "projectResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "spec"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "spec": { "type": "object" }
      }
    }
  }
}
