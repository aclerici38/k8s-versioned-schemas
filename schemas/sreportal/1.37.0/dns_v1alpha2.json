          ]
        },
        "observedGeneration": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "skippedEntries": {
          "description": "skippedEntries lists the discovered entries dropped on the last reconcile\nbecause they failed DNSRecord validation (FQDN pattern or record-type\nenum). They are excluded from the produced DNSRecords instead of aborting\nthe whole reconcile. The list is a bounded sample; the full count is\ncarried by the EntriesValid condition and the dns_entries_invalid_total\nmetric.",
          "items": {
            "additionalProperties": false,
            "description": "SkippedFQDNStatus describes a single entry dropped during validation.",
            "properties": {
              "fqdn": {
                "description": "fqdn is the offending fully qualified domain name (truncated to the DNS\nname length limit).",
                "maxLength": 253,
                "type": "string"
              },
              "reason": {
                "description": "reason is a short machine-friendly cause (e.g. invalid_fqdn).",
                "type": "string"
              },
              "recordType": {
                "description": "recordType is the DNS record type of the dropped entry (truncated). It is\nbounded because a dropped entry's record type is source-controlled and\nunbounded (e.g. a Crossplane Scaleway Record type), and an unbounded value\ncould bloat the status object past the etcd size limit.",
                "maxLength": 16,
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceType": {
                "description": "sourceType is the source kind that produced the entry.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "fqdn",
              "reason"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
