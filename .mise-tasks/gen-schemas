#!/usr/bin/env bash
#MISE description="Generate JSON schemas from each app's upstream CRDs (defaults to every app in apps/)"
set -euo pipefail
# Usage: mise run gen-schemas apps/kgateway.yaml apps/cilium.yaml
# Usage: mise run gen-schemas
# Apps are independent and the work is nearly all network wait, so they run
# JOBS at a time (default 8). Each app tallies its schema count here.

export TALLY="${TALLY:-$(mktemp -d)}"

# Given a GitHub tree URL (https://github.com/owner/repo/tree/ref/path/to/dir),
# fetch all YAML files in that directory and output them as a single multidoc stream.
fetch_github_folder() {
  IFS=/ read -r _ _ _ owner repo _ ref path <<<"$1"
  curl -sfL -H "Authorization: ${GITHUB_TOKEN:+token $GITHUB_TOKEN}" \
    "https://api.github.com/repos/$owner/$repo/contents/$path?ref=$ref" |
    yq -p json -o tsv '.[] | select(.name | test("\.ya?ml$")) | [.download_url]' |
    while read -r url; do
      echo "---"
      curl -sfL "$url"
    done
}

# Filter CRDs out of multidocs and save to metadata.name
filter_crds() {
  local dir="$1" tmp
  tmp="$(mktemp)"
  yq eval 'select(.kind == "CustomResourceDefinition")' - >"$tmp"
  if [ -s "$tmp" ]; then
    mkdir -p "$dir"
    yq eval -s "\"${dir}/\" + .metadata.name + \".yaml\"" "$tmp"
  fi
  rm -f "$tmp"
}

process_app() {
  app_file="$1"
  VERSION="$(yq '.version' "$app_file")"
  APP_NAME="$(basename "$app_file" .yaml)"
  SCHEMAS_DIR="schemas/${APP_NAME}/${VERSION#v}"
  CRDS_DIR="crds/${APP_NAME}/${VERSION#v}"
  mkdir -p "$SCHEMAS_DIR"

  FILE_URLS="$(yq '.fileUrls[]' "$app_file")" || true
  GITHUB_FOLDERS="$(yq '.githubFolders[]' "$app_file")" || true
  CHART_URL="$(yq '.helm.chartUrl // ""' "$app_file")"
  VALUES="$(yq '.helm.requiredValues // ""' "$app_file")"
  VALUES_SCHEMA_URL="$(yq '.helm.valuesSchemaUrl // ""' "$app_file")"

  rm -f "${CRDS_DIR:?}"/* 2>/dev/null || true
  rm -f "${SCHEMAS_DIR:?}"/*
  echo ""
  echo "Processing $APP_NAME version $VERSION"

  for url in $FILE_URLS; do
    version_url="${url//\$\{VERSION\}/$VERSION}"
    echo "Fetching CRDs from $version_url"
    curl -sfL "$version_url" | filter_crds "$CRDS_DIR"
  done

  for folder_url in $GITHUB_FOLDERS; do
    folder_url="${folder_url//\$\{VERSION\}/$VERSION}"
    fetch_github_folder "$folder_url" | filter_crds "$CRDS_DIR"
  done

  if [ -n "$CHART_URL" ]; then
    PULL_DIR="$(mktemp -d)"
    helm pull "$CHART_URL" --version "$VERSION" --untar -d "$PULL_DIR"
    CHART_DIR="$(ls -d "$PULL_DIR"/*/)"

    if [ -z "$VALUES_SCHEMA_URL" ] && [ -f "$CHART_DIR/values.schema.json" ]; then
      echo "Found values schema in $APP_NAME chart"
      cp "$CHART_DIR/values.schema.json" "$SCHEMAS_DIR/values.schema.json"
    fi

    if [ -z "$VALUES" ]; then
      helm show crds "$CHART_DIR" |
        filter_crds "$CRDS_DIR"
    fi
    if ! ls "$CRDS_DIR"/*.yaml &>/dev/null; then
      echo "helm show crds produced no CRDs for $APP_NAME, falling back to helm template"
      echo "$VALUES" | helm template "$APP_NAME" "$CHART_DIR" -f - 2>/dev/null |
        filter_crds "$CRDS_DIR" || true
    fi

    rm -rf "$PULL_DIR"
  fi

  if [ -n "$VALUES_SCHEMA_URL" ]; then
    url="${VALUES_SCHEMA_URL//\$\{VERSION\}/$VERSION}"
    curl -sfL "$url" -o "$SCHEMAS_DIR/values.schema.json"
  fi

  if [ -d "$CRDS_DIR" ] && ls "$CRDS_DIR"/*.yaml &>/dev/null; then
    (cd "$CRDS_DIR" && kustomize create --autodetect)

    # convert writes group-scoped schemas (<group>/<kind>_<version>.json) plus a
    # kubeconform master-standalone copy and a _meta manifest. Only the
    # group-scoped ones are published; flatten them into SCHEMAS_DIR and record
    # the group each one came from for the /{group}/{kind}_{version} redirects.
    STAGE="$(mktemp -d)"
    crd-schema-publisher convert -d "$CRDS_DIR" -o "$STAGE"
    for group_dir in "$STAGE"/*/; do
      GROUP="$(basename "$group_dir")"
      case "$GROUP" in
      _meta | master-standalone) continue ;;
      esac
      for schema in "$group_dir"*.json; do
        fname="$(basename "$schema")"
        if [ -e "$SCHEMAS_DIR/$fname" ]; then
          echo "WARNING: $APP_NAME: $GROUP/$fname overwrites the same filename from another group" >&2
        fi
        cp "$schema" "$SCHEMAS_DIR/$fname"
        echo "$GROUP $fname" >>"$SCHEMAS_DIR/_groups.txt"
      done
    done
    rm -rf "$STAGE"
  fi

  GENERATED=$(find "$SCHEMAS_DIR" -name '*.json' | wc -l)
  if [ "$GENERATED" -eq 0 ]; then
    echo "ERROR: no schemas generated for $APP_NAME. To debug, run: mise run gen-schemas $app_file" >&2
    exit 1
  fi
  echo "$GENERATED" >"$TALLY/$APP_NAME"
}

# Worker: one app per process.
if [ "${1:-}" = "--app" ]; then
  LOG="$(mktemp)"
  exec 3>&1
  exec >"$LOG" 2>&1
  trap 'cat "$LOG" >&3; rm -f "$LOG"' EXIT
  process_app "$2"
  exit
fi

[ "$#" -gt 0 ] || set -- apps/*.yaml
trap 'rm -rf "$TALLY"' EXIT

printf '%s\n' "$@" | xargs -P "${JOBS:-8}" -I{} "$0" --app {}

echo "# schemas generated: $(cat "$TALLY"/* | awk '{n+=$1} END{print n+0}')"
