#!/usr/bin/env bash
#MISE description="Report CRDs the community runs that this repo publishes no schemas for"
set -euo pipefail
shopt -s nullglob
export LC_ALL=C # keep sort/join collation identical everywhere this runs
# Usage: mise run discover:crds        (MIN_REPOS=5 to be stricter)
#
# Render every repo carrying the k8s-at-home or kubesearch topic with flate and
# keep the CRD group/kinds this repo has no schema for. Unlike discover:apps this
# reads what Flux would actually apply, so a chart reached through a templated or
# postBuild-substituted ref counts the same as a literal one.
#
# Writes a TSV of group, new|partial, repo count, kinds, chart names, provenance.

MIN_REPOS="${MIN_REPOS:-3}" # ignore groups fewer than this many clusters run
IGNORE_FILE="${IGNORE_FILE:-.github/crd-ignore.txt}"
CHART_IGNORE_FILE="${CHART_IGNORE_FILE:-.github/discover-ignore.txt}"
OUT="${OUT:-crd-report.tsv}"

WORK="${WORK:-$(mktemp -d)}"
export WORK

TIMEOUT="$(command -v timeout || command -v gtimeout || true)"

case "${1:-}" in
--render)
  # One repo per process. Writes $WORK/found/<repo>, or nothing.
  REPO="$2" BRANCH="$3" SLUG="${2//\//_}"
  DIR="$(mktemp -d)"
  trap 'rm -rf "$DIR"' EXIT

  gh api "repos/$REPO/tarball/$BRANCH" 2>/dev/null | tar xz -C "$DIR" 2>/dev/null ||
    { echo "  $REPO: fetch failed" >&2; exit 0; }
  ROOT="$(echo "$DIR"/*/)"
  [ -d "$ROOT" ] || { echo "  $REPO: empty tarball" >&2; exit 0; }

  # --skip-crds=false rather than --only-crds
  ${TIMEOUT:+$TIMEOUT ${RENDER_TIMEOUT:-300}} flate build all --skip-crds=false -p "$ROOT" \
    --restrict-egress --allow-missing-secrets --no-progress \
    --concurrency "${FLATE_JOBS:-6}" --cache-dir "$WORK/cache" \
    >"$DIR/rendered.yaml" 2>/dev/null || true
  [ -s "$DIR/rendered.yaml" ] || { echo "  $REPO: nothing rendered" >&2; exit 0; }

  yq -rN '
    (select(.kind == "CustomResourceDefinition") | ["crd", .spec.group, .spec.names.kind,
      (.metadata.labels["helm.toolkit.fluxcd.io/namespace"] // "") + "/" + (.metadata.labels["helm.toolkit.fluxcd.io/name"] // ""),
      (.metadata.labels["kustomize.toolkit.fluxcd.io/namespace"] // "") + "/" + (.metadata.labels["kustomize.toolkit.fluxcd.io/name"] // "")] | @tsv),
    (select(.kind == "HelmRelease") | ["hr", (.metadata.namespace // "") + "/" + .metadata.name,
      (.spec.chartRef.namespace // .spec.chart.spec.sourceRef.namespace // .metadata.namespace // "") + "/" + (.spec.chartRef.name // .spec.chart.spec.sourceRef.name // ""),
      .spec.chart.spec.chart // ""] | @tsv),
    (select(.kind == "Kustomization" and (.apiVersion | test("kustomize.toolkit.fluxcd.io"))) | ["ks", (.metadata.namespace // "") + "/" + .metadata.name,
      (.spec.sourceRef.namespace // .metadata.namespace // "") + "/" + (.spec.sourceRef.name // ""),
      .spec.path // ""] | @tsv),
    (select(.kind == "OCIRepository" or .kind == "GitRepository" or .kind == "HelmRepository") | ["src", (.metadata.namespace // "") + "/" + .metadata.name,
      .spec.url // "", .spec.ref.tag // .spec.ref.branch // .spec.ref.semver // ""] | @tsv)
  ' "$DIR/rendered.yaml" 2>/dev/null |
    awk -F'\t' -v OFS='\t' -v repo="$REPO" '
      $1 == "crd" { crd[++n] = $2 "\t" $3 "\t" $4 "\t" $5; next }
      $1 == "src" { url[$2] = $3; tag[$2] = $4; next }
      # A Kustomization and a HelmRelease can share a namespace/name, so the type
      # is part of the key.
      { src[$1 "\t" $2] = $3; extra[$1 "\t" $2] = $4 }
      END {
        for (i = 1; i <= n; i++) {
          split(crd[i], f, "\t")
          if (f[1] == "" || f[2] == "") continue
          hr = (f[3] != "/")
          if (!hr && f[4] == "/") { print f[1], f[2], repo, "", "", "-"; continue }
          id = (hr ? "hr\t" f[3] : "ks\t" f[4])
          u = url[src[id]]; t = tag[src[id]]
          where = (hr ? "HelmRelease " f[3] : "Kustomization " f[4])
          if (u != "") where = where " -- " u (t != "" ? "@" t : "")
          else if (extra[id] != "") where = where " -- " extra[id]
          if (!hr && u != "" && extra[id] != "") where = where " " extra[id]
          chart = ""
          if (hr && u ~ /^oci:\/\//) { chart = u; sub(/.*\//, "", chart) }
          print f[1], f[2], repo, chart, u, where
        }
      }
    ' | sort -u >"$WORK/found/$SLUG"
  echo "  $REPO: $(wc -l <"$WORK/found/$SLUG" | tr -d ' ') CRDs" >&2
  exit 0
  ;;
esac

trap 'rm -rf "$WORK"' EXIT

REPOS_FILE="${REPOS_FILE:-}"
[ -n "$REPOS_FILE" ] || { REPOS_FILE="$WORK/repos.txt"; "$(dirname "$0")/repos" >"$REPOS_FILE"; }
echo "Rendering $(wc -l <"$REPOS_FILE" | tr -d ' ') repos"

# --- what the repo already publishes ------------------------------------------
find crds -name '*.yaml' ! -name kustomization.yaml -print0 2>/dev/null |
  xargs -0 yq -rN 'select(.kind == "CustomResourceDefinition") | [.spec.group, .spec.names.kind] | @tsv' 2>/dev/null |
  awk -F'\t' 'NF==2' | sort -u >"$WORK/known.tsv" || true
KNOWN=$(wc -l <"$WORK/known.tsv" | tr -d ' ')
echo "Matching against $KNOWN published group/kinds"
# An empty crds/ would report every group in every repo as missing
[ "$KNOWN" -ge 100 ] || { echo "ERROR: only $KNOWN published group/kinds, is crds/ populated?" >&2; exit 1; }

# --- what they run ------------------------------------------------------------
# In chunks, because the source cache grows ~15MB a repo and outlives any one of them.
mkdir -p "$WORK/found"
split -l "${CHUNK:-100}" "$REPOS_FILE" "$WORK/chunk."
CHUNKS=$(ls "$WORK"/chunk.* | wc -l | tr -d ' ')
i=0
for chunk in "$WORK"/chunk.*; do
  i=$((i + 1)) start=$SECONDS
  echo "--- chunk $i/$CHUNKS: $(wc -l <"$chunk" | tr -d ' ') repos, ${SECONDS}s elapsed"
  xargs -P "${JOBS:-8}" -n 2 "$0" --render <"$chunk" || true
  echo "--- chunk $i/$CHUNKS done in $((SECONDS - start))s, $(ls "$WORK/found" | wc -l | tr -d ' ') repos with CRDs so far"
  flate cache gc --cache-dir "$WORK/cache" --max-age 15m --include-mirrors >/dev/null 2>&1 || true
done
cat /dev/null "$WORK/found"/* | awk -F'\t' 'NF==6' | sort -u >"$WORK/found.tsv"

FOUND_IN=$(cut -f3 "$WORK/found.tsv" | sort -u | wc -l | tr -d ' ')
echo "Found $(cut -f1,2 "$WORK/found.tsv" | sort -u | wc -l | tr -d ' ') group/kinds across $FOUND_IN repos"
# A few repos always fail (renamed, rate-limited); most of them failing does not.
[ "$FOUND_IN" -ge $(($(wc -l <"$REPOS_FILE") / 4)) ] || { echo "ERROR: only $FOUND_IN repos rendered" >&2; exit 1; }

# --- minus what we already have -----------------------------------------------
for f in "$IGNORE_FILE" "$CHART_IGNORE_FILE"; do
  # Entries are matched as whole strings, so both ends get trimmed -- otherwise a
  # trailing comment leaves the space in front of it on the entry and it matches
  # nothing, silently.
  sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' "$f" 2>/dev/null | awk 'NF'
done >"$WORK/ignore.txt"

awk -F'\t' -v OFS='\t' -v min="$MIN_REPOS" '
  # Ignore entries are globs matched whole. Escape first: an unescaped . in a
  # chart URL would match any character.
  function glob2re(p,  r) { r = p; gsub(/[]\\.[(){}+^$|]/, "\\\\&", r); gsub(/\*/, ".*", r); gsub(/\?/, ".", r); return "^" r "$" }
  FILENAME ~ /ignore/ { ig[++n] = glob2re($0); next }
  FILENAME ~ /known/  { seen[$1 "\t" $2]; group[$1]; next }
  ($1 "\t" $2) in seen { next }
  {
    for (i = 1; i <= n; i++)
      if ($1 ~ ig[i] || ($1 "/" $2) ~ ig[i] || ($4 != "" && $4 ~ ig[i]) || ($5 != "" && $5 ~ ig[i])) next
    if (!(($1, $3) in r)) { r[$1, $3]; repos[$1]++ }
    if (!(($1, $2) in k)) { k[$1, $2]; kinds[$1] = kinds[$1] (kinds[$1] ? "," : "") $2 }
    if ($4 != "" && !(($1, $4) in c)) { c[$1, $4]; charts[$1] = charts[$1] (charts[$1] ? " " : "") $4 }
    if (np[$1] < 5 && !(($1, $6) in p)) { p[$1, $6]; np[$1]++; prov[$1] = prov[$1] (prov[$1] ? ";" : "") $3 " -- " $6 }
  }
  END { for (g in repos) if (repos[g] >= min) print g, (g in group ? "partial" : "new"), repos[g], kinds[g], charts[g], prov[g] }
' "$WORK/ignore.txt" "$WORK/known.tsv" "$WORK/found.tsv" | sort -t$'\t' -k2,2 -k3,3nr >"$OUT"

echo "Wrote $(wc -l <"$OUT" | tr -d ' ') untracked groups run by >= $MIN_REPOS clusters to $OUT"
